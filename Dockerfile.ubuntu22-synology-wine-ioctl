FROM ghcr.io/hitnrun30/backblaze-personal-wine:synology


# Experimental build: keep the known-good Synology image and replace only the
# Wine 11.0 Unix-side ntdll module containing NtDeviceIoControlFile().
# This isolates the Backblaze fixed-drive compatibility experiment from the
# production :synology image.
COPY patches/apply-wine-volume-disk-extents.py /tmp/apply-wine-volume-disk-extents.py

RUN mkdir -p /config/log /tmp/run && \
    /etc/cont-init.d/10-init-users.sh && \
    apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential git flex bison pkg-config gcc-mingw-w64-x86-64 && \
    git clone --depth 1 --branch wine-11.0 \
        https://github.com/wine-mirror/wine.git /tmp/wine-src && \
    python3 /tmp/apply-wine-volume-disk-extents.py && \
    mkdir -p /tmp/wine-build && \
    cd /tmp/wine-build && \
    /tmp/wine-src/configure --enable-win64 && \
    make -j"$(nproc)" -C dlls/ntdll && \
    test -f /tmp/wine-build/dlls/ntdll/ntdll.so && \
    NTDLL_TARGET="$(find /opt/wine-stable -path '*/x86_64-unix/ntdll.so' -print -quit)" && \
    test -n "$NTDLL_TARGET" && \
    echo "Replacing $NTDLL_TARGET with patched Wine 11.0 ntdll.so" && \
    cp /tmp/wine-build/dlls/ntdll/ntdll.so "$NTDLL_TARGET" && \
    rm -rf /tmp/wine-src /tmp/wine-build /tmp/apply-wine-volume-disk-extents.py && \
    apt-get purge -y --auto-remove build-essential git flex bison pkg-config gcc-mingw-w64-x86-64 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* \
        /tmp/.passwd /tmp/.group /tmp/.shadow /tmp/.gshadow /tmp/run /config/log

LABEL org.opencontainers.image.description="Synology Backblaze Wine test with IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS compatibility shim"
ENV WINE_IOCTL_VOLUME_EXTENTS_PATCH=1
